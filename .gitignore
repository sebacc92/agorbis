# Metadatos locales legacy del proveedor retirado
.vercel

# Estado/cache local de Wrangler; puede contener metadatos operativos y nunca
# forma parte del artefacto versionado.
.wrangler

# Temporal de la generación de tipos
src/lib/database.types.ts.tmp

# Estado local del CLI de Supabase: ref del proyecto, versiones y URL del
# pooler. Cambia solo al hacer `supabase link` o `start` y no aporta nada al
# repo; versionarlo genera conflictos en cada máquina.
supabase/.temp

# Estado local de `supabase start`: la rama activa del entorno de cada quien.
supabase/.branches/

# Respaldos operativos sensibles. Los manifiestos reales incluyen nombres de
# objetos y metadatos; deben vivir en almacenamiento cifrado fuera del repo.
# No se ignoran supabase/migrations/*.sql, supabase/migration-drafts/*.sql ni
# supabase/templates/*.html: los borradores se versionan, pero quedan fuera del
# directorio ejecutable de Supabase.
/backups/
/backup/
/.agorbis-backups/
/agorbis-backup-*/
/agorbis-restore-drill-*/
/agorbis-git-recovery-*/
