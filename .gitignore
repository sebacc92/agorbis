*.backup
*.pgdump
*.bundle
*.bundle.gpg
*.git-recovery.tar
*.git-recovery.tar.gpg
*.sql.gz
*.sql.zst
*.tar.zst
backup-manifest.json
*.backup-manifest.json
git-bundle-manifest.json
SHA256SUMS.backup
SHA256SUMS.git-recovery

