# -----------------------------------------------------------------------------
# Agorbis · variables de entorno
# Copiá este archivo a `.env` y completalo. `.env` está en .gitignore.
#
# Para `pnpm dev` con Supabase local alcanzan cuatro: PUBLIC_SUPABASE_URL,
# PUBLIC_SUPABASE_ANON_KEY y SUPABASE_SECRET_KEY (los valores los imprime
# `pnpm exec supabase start`) y PUBLIC_SITE_URL. Registrarse o ingresar en local
# necesita además Turnstile: usá las claves públicas de prueba de Cloudflare
# con TURNSTILE_TESTING="true", como hace `scripts/run-e2e.mjs`. Todo lo demás
# son atestaciones y textos de Producción que exige el preflight; en local
# pueden quedar vacíos o con los valores de ejemplo.
#
# No se separa en un archivo de desarrollo y otro de Producción a propósito:
# `scripts/recovery-inventory.mjs` y
# `scripts/test-cloudflare-public-build-environment.mjs` leen este archivo como
# inventario completo de variables y fallan si falta alguna.
# -----------------------------------------------------------------------------

# Proyecto Supabase. En producción la variable pública contiene una
# `sb_publishable_...`; en local usá PUBLISHABLE_KEY de `supabase status -o env`.
PUBLIC_SUPABASE_URL="http://127.0.0.1:54821"
PUBLIC_SUPABASE_ANON_KEY=""

# Sólo servidor. La generación de resúmenes la usa para las RPC protegidas de
# cache/lease; los cron también la usan para mantenimiento y notificaciones.
# NUNCA la prefijes con PUBLIC_ ni la uses en un componente de cliente. Debe
# ser una `sb_secret_...` moderna; no pegues la JWT service_role legacy.
SUPABASE_SECRET_KEY=""

# Atestación del preflight: debe coincidir con Auth > Rate Limits en Supabase
# Cloud. No configura GoTrue desde la app. El stack local usa un margen mayor
# exclusivamente para ejecutar todos los correos E2E en una sola corrida.
SUPABASE_AUTH_EMAIL_RATE_LIMIT_PER_HOUR=""
# Estas atestaciones no cambian Supabase: hacen que el corte falle hasta que el
# Dashboard coincida con la arquitectura A/B y el hardening documentado.
SUPABASE_AUTH_CAPTCHA_ENABLED=""
SUPABASE_AUTH_CAPTCHA_PROVIDER=""
SUPABASE_AUTH_IP_FORWARDING_ENABLED=""
SUPABASE_AUTH_REQUIRE_CURRENT_PASSWORD_ENABLED=""
SUPABASE_AUTH_SIGNUPS_ENABLED=""
SUPABASE_AUTH_EMAIL_CONFIRMATIONS_ENABLED=""
SUPABASE_AUTH_DOUBLE_CONFIRM_EMAIL_CHANGES_ENABLED=""
SUPABASE_AUTH_ANONYMOUS_SIGN_INS_ENABLED=""
SUPABASE_AUTH_PHONE_AUTH_ENABLED=""
SUPABASE_AUTH_MIN_PASSWORD_LENGTH=""
# Requisitos de caracteres con el nombre que usa el CLI de Supabase, no el
# rótulo del Dashboard: Producción es "letters_digits" (12 caracteres con
# letras y números; mayúsculas y símbolos no son obligatorios, D101).
SUPABASE_AUTH_PASSWORD_REQUIREMENTS=""
# Plan efectivo del proyecto Supabase de Producción: "free", "pro", "team" o
# "enterprise". Es una atestación, no configura nada. El arranque usa Free
# (D91); la protección contra contraseñas filtradas sólo existe desde Pro, así
# que con "free" la atestación honesta de abajo es "false" y desde "pro" debe
# ser "true". Cambiar de plan exige actualizar las dos juntas.
SUPABASE_PLAN=""
SUPABASE_AUTH_LEAKED_PASSWORD_PROTECTION_ENABLED=""
SUPABASE_AUTH_MFA_TOTP_ENROLL_ENABLED=""
SUPABASE_AUTH_MFA_TOTP_VERIFY_ENABLED=""
SUPABASE_AUTH_MFA_MAX_ENROLLED_FACTORS=""
# Origen y allowlist que figuran efectivamente en Auth > URL Configuration.
# Redirect URLs es una lista separada por comas y sin comodines.
SUPABASE_AUTH_SITE_URL=""
SUPABASE_AUTH_REDIRECT_URLS=""
# Lista separada por comas de las seis alertas habilitadas en Email Templates.
SUPABASE_AUTH_SECURITY_NOTIFICATIONS_ENABLED=""
SUPABASE_LEGACY_SERVICE_ROLE_DISABLED=""

# OpenAI queda fuera del lanzamiento inicial: estos valores deben permanecer
# vacíos hasta publicar el subencargado, destino, DPA, retención y una nueva
# versión de privacidad. El preflight falla si se cargan antes de ese cambio.
OPENAI_API_KEY=""
OPENAI_SUMMARY_MODEL=""

# Secreto de los handlers internos de mantenimiento: bajas de cuenta, limpieza
# de imágenes, retención, cierres/notificaciones y escalamiento de reclamos.
# Usá un valor aleatorio de al menos 32 bytes y guardalo sólo como secreto del
# Worker; los Cron Triggers internos no lo exponen al navegador.
CRON_SECRET=""
# Atestación del plan efectivo: `paid` es obligatorio porque Agorbis usa los
# cinco Cron Triggers permitidos por Free y necesita más de 10 ms de CPU.
# No configura ni factura Cloudflare por sí sola.
CLOUDFLARE_WORKERS_PLAN=""
# Atestación manual previa al corte: Cache Rules y Page Rules de la zona fueron
# exportadas/revisadas y ninguna regla Cache Everything/Edge TTL alcanza HTML,
# Auth ni rutas dinámicas. No modifica Cloudflare por sí sola.
CLOUDFLARE_ZONE_DYNAMIC_CACHE_RULES_REVIEWED=""

# URL pública del sitio. Se usa para el sitemap, los OG tags y el redirect
# del magic link. En Producción debe ser el dominio final del Worker.
PUBLIC_SITE_URL="http://localhost:5173"

# Google como opción de acceso (D122). El proveedor está habilitado en Supabase
# Auth; el Client Secret vive en Supabase, nunca acá. Con "false" el botón no se
# muestra y el ingreso por correo sigue igual (reversión de D122).
PUBLIC_GOOGLE_AUTH_ENABLED="true"
# Obligatorio cuando Google está habilitado; describí los destinos reales
# cubiertos por Google/Supabase según la configuración y acuerdos vigentes.
PUBLIC_GOOGLE_PROCESSING_LOCATION=""
PUBLIC_GOOGLE_PROCESSING_LOCATION_EN=""

# Facebook se habilita por separado, tras configurar/probar Meta y Supabase.
# El App Secret se guarda sólo en Supabase. Guía: docs/social-auth-setup.md.
PUBLIC_FACEBOOK_AUTH_ENABLED="false"
PUBLIC_FACEBOOK_PROCESSING_LOCATION=""
PUBLIC_FACEBOOK_PROCESSING_LOCATION_EN=""

# Widget A: es el único que ve la persona. La site key es pública; el secret
# nunca debe usar prefijo PUBLIC_. Hostnames es el allowlist del backend de este
# despliegue, separado por comas y sin protocolo ni ruta.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
TURNSTILE_HOSTNAMES=""
# Widget B no se carga en Agorbis y sus claves no viven en este entorno. Esta
# atestación refleja el allowlist configurado en Cloudflare para el secreto que
# se guarda únicamente en Supabase Auth.
TURNSTILE_SUPABASE_GUARD_HOSTNAMES=""

# Información pública que aparece en privacidad y términos. El preflight de
# producción rechaza los placeholders: completalos con la identidad real del
# responsable antes de abrir el registro.
PUBLIC_LEGAL_CONTROLLER_NAME=""
PUBLIC_LEGAL_CONTACT_EMAIL=""
# Sin domicilio: es la casa del responsable y no se publica. El contacto para
# ejercer derechos es el correo de arriba.
# Código público del responsable emitido por AAIP/TAD. No es el registro de la
# base. Formato: RL-AAAA-NNNNNNNN-APN-DNPDP#AAIP.
PUBLIC_AAIP_CONTROLLER_ID=""
# Número que figure en la constancia de aprobación del Paso 2 para la base. No
# usar el expediente EX-, documentos RE-/PV-, el RL del responsable, la
# transacción TAD ni el CUIL/CUIT. Debe permanecer vacío hasta que AAIP lo emita.
AAIP_DATABASE_REGISTRATION_STATUS="pending"
PUBLIC_AAIP_DATABASE_REGISTRATION_STATUS="pending"
PUBLIC_AAIP_DATABASE_REGISTRATION_ID=""
RETENTION_RECONCILIATION_STATUS="unreconciled"
PRODUCTION_BACKUP_STATUS="not_verified"
GOOGLE_DRIVE_BACKUP_STATUS="inactive"
SENSITIVE_PARTICIPATION_CONSENT_0059_STATUS="draft_not_applied"

# Registro público de subencargados. Cada destino debe describir la región o
# países que realmente cubren el proyecto/contrato elegido, incluidos los
# tratamientos globales. Para Cloudflare debe identificar por separado el DNS
# autoritativo, Workers Edge Compute como alojamiento, ejecución global y
# reverse proxy HTTP, y las dos configuraciones Turnstile A/B. No atribuir WAF,
# caché o localización restringida si no están realmente configurados y
# documentados. No adivines estos valores: confirmalos en el panel, el DPA y la
# respuesta contractual. Cada texto tiene una versión inglesa `_EN` para que el
# aviso no cambie de idioma a mitad de página.
# PUBLIC_TRANSFER_SAFEGUARDS describe el mecanismo argentino que ya cubre el
# primer request y cualquier flujo que llegue a Cloudflare sin una decisión
# afirmativa previa y acreditable para ese tratamiento. Esto incluye la lectura
# pública y, cuando no pueda acreditarse una decisión anterior vigente, ingreso,
# recuperación, seguridad y ejercicio de derechos. Debe ser una cláusula modelo
# AAIP efectivamente incorporada, una aprobación documentada de AAIP o una
# excepción concreta del artículo 12; el consentimiento del alta y un DPA
# genérico no alcanzan retroactivamente para esos tratamientos. La retención
# incluye logs, correo, backups y cachés.
PUBLIC_SUPABASE_PROCESSING_LOCATION=""
PUBLIC_SUPABASE_PROCESSING_LOCATION_EN=""
PUBLIC_RESEND_PROCESSING_LOCATION=""
PUBLIC_RESEND_PROCESSING_LOCATION_EN=""
PUBLIC_CLOUDFLARE_PROCESSING_LOCATION=""
PUBLIC_CLOUDFLARE_PROCESSING_LOCATION_EN=""
PUBLIC_TRANSFER_SAFEGUARDS=""
PUBLIC_TRANSFER_SAFEGUARDS_EN=""
PUBLIC_PROVIDER_RETENTION_SUMMARY=""
PUBLIC_PROVIDER_RETENTION_SUMMARY_EN=""
